PORT=4000
NODE_ENV=development
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/?appName=<app>
MONGO_DB_NAME=pulse
JWT_SECRET=<long random string>
JWT_EXPIRES_IN=1d
JWT_RESET_EXPIRES_IN=10m
OTP_EXPIRES_IN_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=60
AUTH_RATE_LIMIT_PER_15_MIN=50
CORS_ORIGIN=http://localhost:5173

# First admin, created by `npm run seed`
ADMIN_NAME=
ADMIN_EMAIL=

# Task attachments (Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=pulse
MAX_UPLOAD_MB=10

# If set, email goes through Brevo's HTTPS API instead of SMTP (needed on hosts that block SMTP ports)
BREVO_API_KEY=

MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USER=
MAIL_PASS=
MAIL_FROM="PULSE" <no-reply@pulse.io>
